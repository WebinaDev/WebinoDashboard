{
  "name": "webino-dashboard-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Webino Dashboard documentation (bilingual FA/EN)",
  "scripts": {
    "docusaurus": "docusaurus",
    "sync:openapi": "mkdir -p openapi static/openapi && cp ../backend/storage/app/openapi.json openapi/openapi.json && cp openapi/openapi.json static/openapi/openapi.json",
    "prebuild": "npm run sync:openapi",
    "prestart": "npm run sync:openapi",
    "start": "docusaurus start --port 3091",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "start:fa": "docusaurus start --locale fa --port 3091",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.6.3",
    "@docusaurus/preset-classic": "^3.6.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "redocusaurus": "^2.1.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.6.3",
    "@docusaurus/tsconfig": "^3.6.3",
    "@docusaurus/types": "^3.6.3",
    "typescript": "~5.5.2"
  },
  "engines": {
    "node": ">=18.0"
  }
}
