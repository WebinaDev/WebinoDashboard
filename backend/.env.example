APP_NAME=Laravel
# Generated by ./install.sh — do not edit manually on first setup; re-run with --force-env to reset.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WEBINO_BASE_URL=http://127.0.0.1
WEBINOCRM_LICENSE_HMAC_SECRET=

# SPA URL for payment gateway redirects (browser returns here after bank)
FRONTEND_URL=http://localhost:3000

# Sanctum stateful domains (comma-separated, no scheme)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3080,127.0.0.1,127.0.0.1:3000,127.0.0.1:3080

# Auth cookie (httpOnly, used by Next.js middleware)
AUTH_COOKIE_NAME=webino_auth_token
AUTH_COOKIE_MAX_MINUTES=10080

# Zarinpal — when ZARINPAL_MERCHANT_ID is set, real StartPay URLs are used (otherwise stub intent).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Digipay UPG — OAuth + ticket API (see mydigipay.com docs). Stub intent if incomplete.
DIGIPAY_BASE_URL=https://uat.mydigipay.info/digipay/api
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_PROVIDER_ID=
DIGIPAY_CELL_NUMBER=
DIGIPAY_PREFERRED_GATEWAY=0

# Optional git clone on POST /modules/{slug}/install when repo URL is set on dashboard_modules
MODULE_GIT_ENABLED=false
MODULE_GIT_TIMEOUT=120
# When true, dashboard asks CRM for PAT-injected HTTPS clone URL (MODULE slug must be entitled).
MODULE_GIT_CRM_AUTH=false

# Copy accounting bundle from a Webino checkout (absolute path). Honours CRM license unless:
# ACCOUNTING_ALLOW_UNLICENSED_INSTALL=true (local only)
WEBINO_ACCOUNTING_SOURCE_PATH=
ACCOUNTING_ALLOW_UNLICENSED_INSTALL=false

# Optional provision bootstrap HMAC (must match ERM provision_webhook_secret)
WEBINO_PROVISION_HMAC_SECRET=

# Injected by WebinoERP Platform during automated site provisioning
TENANT_LICENSE_KEY=
TENANT_PROVISION_TOKEN=
TENANT_SEED_JSON=

# Auth cookie + optional 2FA enforcement (empty = off until enrollment UI ships)
AUTH_COOKIE_NAME=webino_auth_token
AUTH_ENFORCE_2FA_ROLES=

# Comma-separated origins for CORS (use * in local dev without credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3080,http://127.0.0.1:3000,http://127.0.0.1:3080
