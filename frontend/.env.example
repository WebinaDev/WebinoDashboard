# Generated by ./install.sh — do not copy manually; run ./install.sh first.
# Public API base URL (empty = same-origin via rewrite/proxy)
NEXT_PUBLIC_API_URL=

# Server-side API URL for middleware (Docker: http://backend:8080)
INTERNAL_API_URL=http://localhost:8080

# Auth cookie name (must match backend AUTH_COOKIE_NAME)
AUTH_COOKIE_NAME=webino_auth_token

# Dev proxy target for next.config rewrites
API_PROXY_TARGET=http://localhost:8080
