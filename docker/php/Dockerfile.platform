# Production backend image for multi-site platform (code baked in).
#
# Base is php:cli (not frankenphp): Docker Hub / dunglas pulls 403 on many IR IPs,
# and a copied frankenphp binary lacks libwatcher (Octane exit 127). Same approach
# as WebinoERP docker/php/Dockerfile.platform — artisan serve is the runtime.
#
# PHP_IMAGE / COMPOSER_IMAGE can be overridden for IR Hub mirrors:
#   hub.hamdocker.ir/library/php:8.3-cli-bookworm
#   hub.hamdocker.ir/library/composer:2
# COMPOSER_MIRROR: set via build-arg (IR builds pass Aliyun; Packagist often fails with curl error 18).
#
# All FROM-related ARGs MUST be declared before the first FROM (BuildKit global scope).
# COPY --from=${VAR} is unsupported; use a named stage instead.
ARG PHP_IMAGE=php:8.3-cli-bookworm
ARG COMPOSER_IMAGE=composer:2

FROM ${COMPOSER_IMAGE} AS composer_src

FROM ${PHP_IMAGE}

ARG APT_MIRROR=
ARG FORCE_APT_IPV4=1
ARG REDIS_PECL_VERSION=6.0.2
# Empty by default; IR builds pass Aliyun via --build-arg COMPOSER_MIRROR=...
ARG COMPOSER_MIRROR=

COPY docker/php/install-redis.sh /tmp/install-redis.sh

RUN set -eux; \
    if [ -n "$APT_MIRROR" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list; \
      fi; \
    fi; \
    if [ "${FORCE_APT_IPV4}" = "1" ]; then \
      printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "5";\n' \
        > /etc/apt/apt.conf.d/99webina-build; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        $PHPIZE_DEPS \
        git unzip libzip-dev libpq-dev libxml2-dev libsqlite3-dev curl; \
    docker-php-ext-install dom xml zip pdo_sqlite pdo_pgsql opcache pcntl; \
    chmod +x /tmp/install-redis.sh; \
    REDIS_PECL_VERSION="$REDIS_PECL_VERSION" /tmp/install-redis.sh; \
    rm -f /tmp/install-redis.sh; \
    docker-php-ext-enable redis opcache; \
    rm -rf /var/lib/apt/lists/*

RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini

COPY --from=composer_src /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY backend/composer.json backend/composer.lock* ./
# Prefer locked install. Packagist from IR often fails (HTTP/2 curl 18) — use mirror + HTTP/1.1 + retries.
# Do NOT fall back to `composer update` in image builds (needs network metadata + drifts lock).
RUN set -eux; \
    composer config platform.php 8.3.32; \
    composer config --global process-timeout 2000; \
    if [ -n "${COMPOSER_MIRROR}" ]; then \
      composer config -g repos.packagist composer "${COMPOSER_MIRROR}"; \
    fi; \
    # Force libcurl HTTP/1.1 inside Composer (HTTP/2/3 stream resets → curl error 18 from many IR IPs).
    mkdir -p /tmp/composer-src; \
    cp /usr/bin/composer /tmp/composer.phar; \
    php -r '$p=new Phar("/tmp/composer.phar"); $p->extractTo("/tmp/composer-src");'; \
    find /tmp/composer-src -type f -name 'CurlDownloader.php' -print0 \
      | xargs -0 -r sed -i \
        -e 's/CURL_HTTP_VERSION_3/CURL_HTTP_VERSION_1_1/g' \
        -e 's/CURL_HTTP_VERSION_2TLS/CURL_HTTP_VERSION_1_1/g' \
        -e 's/CURL_HTTP_VERSION_2_0/CURL_HTTP_VERSION_1_1/g'; \
    i=1; \
    until php /tmp/composer-src/bin/composer install \
        --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader; do \
      if [ "$i" -ge 5 ]; then \
        echo "composer install failed after ${i} attempts" >&2; \
        exit 1; \
      fi; \
      echo "composer install attempt ${i} failed; retrying in $((i * 5))s..." >&2; \
      sleep $((i * 5)); \
      i=$((i + 1)); \
    done; \
    rm -rf /tmp/composer-src /tmp/composer.phar

COPY backend/ ./
RUN composer dump-autoload --optimize --no-dev --no-scripts \
    && mkdir -p database storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache database

COPY docker/php/entrypoint-platform.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
# FrankenPHP/Octane skipped on platform images (IR Hub + libwatcher). Serve is the runtime.
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8080"]
