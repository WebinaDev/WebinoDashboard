# Per-client Compose env — copy to clients/<slug>/.env

# Unique short id (DNS-safe): used for container aliases and COMPOSE_PROJECT_NAME
CLIENT_SLUG=acme

# Public hostname (DNS A/AAAA → this server)
CLIENT_DOMAIN=acme.example.com

# Postgres (also injected into backend containers)
POSTGRES_DB=webino_dashboard
POSTGRES_USER=webino
POSTGRES_PASSWORD=change_me_strong_password
