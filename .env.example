# Root compose / host secrets for WebinoDashboard.
# Copy to `.env` beside docker-compose.yml before `docker compose up`.

POSTGRES_DB=webino_dashboard
POSTGRES_USER=webino
POSTGRES_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

WEB_HTTP_PORT=3080
WEB_HTTPS_PORT=3443

# Mirror critical values into backend/.env as well (APP_KEY, WEBINO_*, TENANT_*).
# One-liner migrate inside the stack:
#   docker compose exec backend php artisan migrate --force
