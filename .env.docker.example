# Copy to project root as `.env` for docker compose:
#   cp .env.docker.example .env
#
# Copy backend env and edit secrets:
#   cp backend/.env.example backend/.env
#   php artisan key:generate   # or set APP_KEY manually

# --- Compose / Postgres ---
POSTGRES_DB=webino_dashboard
POSTGRES_USER=webino
POSTGRES_PASSWORD=change_me_strong_password

# Published ports (aaPanel: use 80/443 or map to e.g. 3080/3443 behind panel proxy)
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
